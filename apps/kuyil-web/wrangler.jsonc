{
  "name": "kuyil-web",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": { "ENVIRONMENT": "local" },
  "env": {
    "dev": {
      "vars": { "ENVIRONMENT": "dev" }
    },
    "stage": {
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "stage" },
      "services": [{ "binding": "API", "service": "kuyil-api-edge-stage" }]
    },
    "prod": {
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "prod" },
      "services": [{ "binding": "API", "service": "kuyil-api-edge-prod" }]
    }
  }
}
